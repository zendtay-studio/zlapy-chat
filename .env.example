# ─────────────────────────────────────────────────────────────
# Zlapy — plantilla de configuración
# ─────────────────────────────────────────────────────────────
#  Copia este fichero como `.env` y ajusta lo que quieras.
#  Tiempos en milisegundos. Los enteros se validan al arrancar:
#  fuera de rango, el servidor no arranca.
#  Este fichero contiene SECRETOS: nunca lo subas a git.
#  Tras editarlo, reinicia el servidor.

# ══ 1) RED ═══════════════════════════════════════════════════

# Puerto TCP donde escucha (HTTP y HTTPS en el mismo puerto).
PORT=3000

# Interfaz de escucha: auto = todas las interfaces,
# loopback = solo esta máquina (p. ej. tras un proxy TLS).
BIND_HOST=auto

# Forzar HTTPS: redirige el tráfico en claro y marca la cookie Secure.
# Solo tiene efecto si existen los certificados de abajo.
# Desactívalo solo en una red de confianza.
FORCE_TLS=true

# Certificado y llave TLS. Vacío = cert.pem y key.pem en la raíz del proyecto.
TLS_CERT_FILE=
TLS_KEY_FILE=

# ══ 2) BASES DE DATOS Y CREDENCIAL DEL PROPIETARIO ═══════════

# Carpeta donde viven las bases y los adjuntos. Vacío = "data" del proyecto.
DATA_DIR=data

# Nombre (o ruta) de la base principal; la extensión .db se añade sola.
# Vacío = "zlapy" (→ data/zlapy.db).
DB_NAME=zlapy

# Nombre (o ruta) de la base de adjuntos. Vacío = "<DB_NAME>-blob"
# (→ data/zlapy-blob.db). Si una versión anterior ya creó data/blob.db,
# se conserva ese nombre para no perder los adjuntos.
BLOB_DB_NAME=

# Usuario del propietario de la instalación. Junto con DB_PASSWORD
# forma la CREDENCIAL de la que se deriva (scrypt) la llave maestra
# que cifra toda la base. Sin esta credencial el servidor no arranca.
DB_USER=

# Contraseña del propietario. Cámbiala solo con:
#   npm run owner -- credential --user USUARIO --password NUEVA
# (re-cifra toda la base; editarl a mano rompe el arranque).
# Sin comillas, "#" ni espacios en los extremos.
# Guárdala también FUERA de la máquina: sin ella los respaldos no sirven.
DB_PASSWORD=

# Alternativa a DB_PASSWORD: fichero 0600 con la contraseña.
# Si está definido, manda sobre DB_PASSWORD y la contraseña no
# queda escrita en este fichero.
DB_PASSWORD_FILE=

# ══ 3) SESIONES ══════════════════════════════════════════════

# Vigencia del token de sesión (cookie JWT). 30 días por defecto.
# Rango válido: 60000 (1 minuto) – 31536000000 (365 días); fuera de
# rango el servidor no arranca.
# No hay tabla de sesiones: el token se verifica en cada petición y se
# revoca de golpe (por cuenta) rotando la versión de autenticación.
AUTH_SESSION_TTL_MS=2592000000

# ══ 4) LÍMITES DE CONTENIDO ══════════════════════════════════

# Máximo de caracteres por mensaje directo.
MESSAGE_DIRECT_CHAR_LIMIT=10000

# Máximo de caracteres por mensaje de grupo.
MESSAGE_GROUP_CHAR_LIMIT=15000

# Máximo de caracteres del texto de una historia.
STORY_TEXT_CHAR_LIMIT=140

# Máximo de caracteres de la descripción del perfil.
PROFILE_DESCRIPTION_CHAR_LIMIT=140

# Duración máxima de una grabación de audio.
MAX_AUDIO_DURATION_MS=60000

# Máximo de elementos por galería y de caracteres codificados por galería.
MAX_GALLERY_ITEMS=20
MAX_GALLERY_ENCODED_CHARS=24000000

# Máximo de caracteres multimedia por mensaje (≤ MAX_HTTP_BODY_BYTES).
MAX_MESSAGE_DATA_CHARS=24000000

# Tamaño máximo del cuerpo de las peticiones HTTP (32 MiB).
MAX_HTTP_BODY_BYTES=33554432

# Tope del adjunto que viaja EN LÍNEA (data-URL) en un mensaje.
MAX_INLINE_MEDIA_CHARS=262144

# Tope del medio de una historia que viaja en línea (data-URL).
STORY_INLINE_CHAR_LIMIT=4000000

# Máximo de miembros por grupo: el coste por mensaje crece con N.
MAX_GROUP_MEMBERS=200

# ══ 5) ANTI-SPAM ═════════════════════════════════════════════

# Mensajes máximos por cuenta dentro de la ventana de abajo.
MESSAGE_RATE_LIMIT=30

# Ventana del límite de mensajes (60000 = 1 minuto).
MESSAGE_RATE_WINDOW_MS=60000

# ══ 6) CADUCIDAD ═════════════════════════════════════════════

# Vigencia de una nota de perfil y de las historias (24 h).
NOTE_TTL_MS=86400000
STORY_TTL_MS=86400000

# ══ 7) RENDIMIENTO ═══════════════════════════════════════════

# Caché de páginas de SQLite, en KiB, por conexión.
SQLITE_CACHE_SIZE_KB=64000

# Tiempo máximo que SQLite espera el bloqueo si la base está ocupada.
SQLITE_BUSY_TIMEOUT_MS=5000

# Caché de páginas de chat: vigencia, nº máximo de entradas y cota
# global de bytes (0 en las dos primeras la desactiva).
CHAT_PAGE_CACHE_TTL_MS=10000
CHAT_PAGE_CACHE_MAX=20
CHAT_PAGE_CACHE_MAX_BYTES=67108864

# Carpeta persistente para los WebP del paquete animado bbot.
# Ruta relativa a la raíz del proyecto; se genera al iniciar si falta.
# La base de datos sigue siendo la fuente de verdad de los stickers.
BBOT_STICKER_PACK_DIR=src/bbot-stickers

# ══ 8) INTEGRACIONES EXTERNAS (secretos) ═════════════════════

# Token del túnel de Cloudflare para `npm run tunnel`.
# Vacío = el túnel no arranca.
CLOUDFLARE_TUNNEL_TOKEN=

# Clave de API de Giphy para los stickers. Vacío = sin stickers.
GIPHY_API_KEY=

# ══ 9) SUPERVISOR (npm start) ════════════════════════════════
#  Vigila al servidor: lo reinicia si muere o se cuelga.
#  Valores fuera de rango avisan y caen al valor por defecto.

# Fichero donde se publica el PID del servidor.
SUPERVISOR_PID_FILE=.zlapy.pid

# Ruta HTTP del health check.
SUPERVISOR_HEALTH_PATH=/healthz

# Puerto inicial del health check; el real lo anuncia el servidor.
# Vacío = usar PORT.
SUPERVISOR_HEALTH_PORT=

# Cada cuánto se comprueba la salud.
SUPERVISOR_HEALTH_MS=15000

# Gracia para que el servidor responda al arrancar.
SUPERVISOR_STARTUP_MS=30000

# Tiempo de espera de cada chequeo de salud.
SUPERVISOR_HEALTH_TIMEOUT_MS=5000

# Fallos de salud seguidos antes de reiniciar por "colgado".
SUPERVISOR_FAILURES_BEFORE_KILL=3

# Backoff inicial y máximo entre reinicios (1 s → 2 s → 4 s… → 30 s).
SUPERVISOR_BACKOFF_MS=1000
SUPERVISOR_BACKOFF_MAX_MS=30000

# Fallos de ARRANQUE seguidos antes de parar y no reintentar (0 = sin tope).
SUPERVISOR_MAX_RESTARTS=10

# Caídas en caliente seguidas a partir de las cuales se avisa del
# crash-loop (el servicio NO se apaga).
SUPERVISOR_HOT_CRASH_THRESHOLD=5

# Tiempo sano necesario para olvidar la racha de fallos.
SUPERVISOR_STABLE_MS=60000

# Latido servidor → supervisor (canal IPC) y su watchdog: si el servidor
# deja de latir estando en marcha (event loop bloqueado), se reinicia.
# El latido solo empieza cuando el servidor anuncia que escucha, así que
# un arranque lento nunca lo dispara.
SUPERVISOR_HB_MS=10000
SUPERVISOR_HB_STALE_MS=45000

# Intentos de instalar dependencias que faltan (el servidor sale con
# código 79) antes de rendirse y pedir intervención. 0 = sin tope.
SUPERVISOR_DEPS_INSTALL_ATTEMPTS=3
