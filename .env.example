# ── Zlapy — plantilla de configuración (.env.example) ──
#  Copia este fichero como `.env` (o deja que el servidor lo
#  cree solo la primera vez) y ajusta los valores.
#  Todas las variables de tiempo van en milisegundos (ms) a
#  menos que se indique lo contrario. Los valores enteros se
#  validan al arrancar: fuera de rango ⇒ el servidor no arranca.
#  Este fichero NO debe contener secretos: los del .env real
#  (CHAT_MASTER_KEY, CLOUDFLARE_TUNNEL_TOKEN, GIPHY_API_KEY).

# ── 1) RED: puerto, escucha y TLS ──
# Puerto TCP en el que escucha el servidor.
# Admite: entero 1–65535.
PORT=3000

# Interfaz de escucha.
# Admite: "auto" (0.0.0.0, todas las interfaces; valor por defecto),
#         "loopback" (solo esta máquina, p. ej. con proxy inverso TLS
#         delante) o "0.0.0.0" (equivalente a auto). Otro valor ⇒ auto.
BIND_HOST=auto

# Forzar HTTPS: toda petición en claro se redirige a https y la cookie de
# sesión se marca como Secure. Solo tiene efecto si existen cert.pem y key.pem.
# Admite: booleano — 1/true/yes/on para activar; 0/false/no/off para
#         desactivar (tráfico y cookie sin cifrar; solo en red de
#         confianza). Cualquier otro valor ⇒ condiciones por defecto (true).
FORCE_TLS=true

# Rutas de los certificados TLS (avanzado). Por defecto cert.pem y key.pem
# en la raíz del proyecto; apúntalas a otro sitio si tus certificados viven
# fuera (p. ej. tras un proxy que termina el TLS).
# Admite: ruta de fichero (relativa o absoluta). Vacío ⇒ raíz del proyecto.
TLS_CERT_FILE=
TLS_KEY_FILE=

# ── 2) DATOS y persistencia (SQLite) ──
# Carpeta para las bases de datos (zlapy.db, blob.db) y demás datos
# persistentes.
# Admite: ruta relativa o absoluta. Vacío ⇒ "data" dentro del proyecto.
DATA_DIR=data

# Caché de páginas de SQLite, en KiB, por conexión.
# Admite: entero 1024–1048576 (1024 KiB ≈ 1 MiB; 64000 ≈ 62.5 MiB).
SQLITE_CACHE_SIZE_KB=64000

# Tiempo máximo que SQLite espera para adquirir el bloqueo cuando la base
# está ocupada (evita errores SQLITE_BUSY).
# Admite: entero 0–60000 (0 = esperar indefinidamente; 5000 = 5 s).
SQLITE_BUSY_TIMEOUT_MS=5000

# ── 3) SEGURIDAD: clave maestra y sesiones ──
# Clave maestra Base64 de EXACTAMENTE 32 bytes para el cifrado en reposo.
# Es la raíz de confianza: quien la obtenga descifra el contenido de todos.
# Vacío ⇒ el servidor genera una clave nueva en el primer arranque de una
# instalación nueva (base sin datos) y la guarda en esta misma línea (en el
# .env real). Con datos en la base y la clave ausente, el servidor NO arranca
# (fail-fast) para no hacer ilegibles los datos. No la compartas ni la subas
# a git.
# Admite: Base64 de 32 bytes (sin comillas) o vacío.
CHAT_MASTER_KEY=

# Vigencia de la sesión de autenticación (cookie/session token).
# Al expirar hay que volver a iniciar sesión.
# Admite: entero 60000–31536000000 ms (1 min – 365 días).
AUTH_SESSION_TTL_MS=2592000000

# ── 4) LÍMITES de contenido (sanitización) ──
# Máximo de caracteres por mensaje directo.
# Admite: entero 1–1000000.
MESSAGE_DIRECT_CHAR_LIMIT=10000

# Máximo de caracteres por mensaje de grupo.
# Admite: entero 1–1000000.
MESSAGE_GROUP_CHAR_LIMIT=15000

# Máximo de caracteres en el texto de una historia.
# Admite: entero 1–100000.
STORY_TEXT_CHAR_LIMIT=240

# Máximo de caracteres en la descripción del perfil.
# Admite: entero 1–100000.
PROFILE_DESCRIPTION_CHAR_LIMIT=140

# Duración máxima de grabación de audio.
# Admite: entero 1000–3600000 ms (1 s – 60 min).
MAX_AUDIO_DURATION_MS=60000

# Cantidad máxima de elementos permitidos en una galería.
# Admite: entero 2–100.
MAX_GALLERY_ITEMS=20

# Máximo de caracteres codificados (multimedia/cifrados) por galería.
# Debe ser ≤ MAX_HTTP_BODY_BYTES o el servidor NO arranca.
# Admite: entero 1–1073741824.
MAX_GALLERY_ENCODED_CHARS=24000000

# Máximo de caracteres de datos multimedia/cifrados aceptados por mensaje.
# Debe ser ≤ MAX_HTTP_BODY_BYTES o el servidor NO arranca.
# Admite: entero 1–1073741824.
MAX_MESSAGE_DATA_CHARS=24000000

# Tamaño máximo del cuerpo de una solicitud HTTP.
# Debe ser ≥ MAX_MESSAGE_DATA_CHARS y ≥ MAX_GALLERY_ENCODED_CHARS.
# Admite: entero 1024–1073741824 bytes (33554432 = 32 MiB).
MAX_HTTP_BODY_BYTES=33554432

# ── 5) ANTI-SPAM: tasa de envío de mensajes ──
# Mensajes máximos permitidos dentro de la ventana indicada abajo.
# Admite: entero 1–1000000.
MESSAGE_RATE_LIMIT=30

# Ventana del límite de mensajes.
# Admite: entero 1–31536000000 ms (1 ms – 365 días; 60000 = 1 min).
MESSAGE_RATE_WINDOW_MS=60000

# ── 6) CADUCIDAD (TTL) de notas e historias ──
# Vigencia de una nota de perfil (se descarta al expirar).
# Admite: entero 60000–2592000000 ms (1 min – 30 días).
NOTE_TTL_MS=86400000

# Vigencia de las historias (se descartan al expirar).
# Admite: entero 60000–2592000000 ms (1 min – 30 días).
STORY_TTL_MS=86400000

# ── 7) RENDIMIENTO: caché de páginas de chat ──
# Tiempo que se conserva una página de chat en caché.
# Admite: entero 0–3600000 ms (0 = las entradas nunca se reutilizan).
CHAT_PAGE_CACHE_TTL_MS=10000

# Número máximo de páginas de chat en caché.
# Admite: entero 0–100000 (0 = desactiva la caché).
CHAT_PAGE_CACHE_MAX=20

# ── 8) INTEGRACIONES EXTERNAS (secretos — no compartir) ──
# Token del túnel de Cloudflare que usa `npm run tunnel` (cloudflared).
# Se obtiene en el panel de Cloudflare (Zero Trust → Networks → Tunnels).
# La configuración del túnel está en zty.yml (copia de zty.yml.example).
# Admite: token de Cloudflare. Vacío ⇒ el túnel no arranca.
CLOUDFLARE_TUNNEL_TOKEN=

# Stickers de Giphy (la usa solo el servidor, en /giphy/search).
# Admite: clave de API de Giphy. Vacío ⇒ sin stickers.
GIPHY_API_KEY=

# ── 9) SUPERVISOR (`npm start` — ops/supervisor.js) ──
#    Vigila al servidor: lo reinicia si muere o se cuelga. El supervisor
#    carga este mismo fichero: PORT y todas las variables SUPERVISOR_*
#    de aquí tienen efecto real sobre `npm start`. Todos los valores
#    admiten enteros (vacío = valor por defecto); un valor inválido
#    AVISA y cae al valor por defecto (el servidor arranca).
# Fichero donde el supervisor publica el PID del servidor hijo.
# Admite: ruta relativa (se resuelve contra la raíz del proyecto) o absoluta.
SUPERVISOR_PID_FILE=.zlapy.pid

# Ruta que consulta el supervisor para saber si el servidor está sano.
# Admite: ruta HTTP (por defecto /healthz).
SUPERVISOR_HEALTH_PATH=/healthz

# Puerto inicial del health check; el supervisor lo sustituye por el que
# anuncia el servidor al arrancar (banner "Zlapy (SQLite) en el puerto NNNN").
# Admite: entero ≥ 1. Vacío = usar PORT.
SUPERVISOR_HEALTH_PORT=

# Cada cuánto comprueba la salud del servidor.
# Admite: entero ≥ 1 ms (por defecto 15000).
SUPERVISOR_HEALTH_MS=15000

# Espera máxima (gracia) para que el servidor responda al arrancar
# (esquema, hidratación...).
# Admite: entero ≥ 1 ms (por defecto 30000 = 30 s).
SUPERVISOR_STARTUP_MS=30000

# Tiempo de espera de cada chequeo de salud HTTP.
# Admite: entero ≥ 1 ms (por defecto 5000).
SUPERVISOR_HEALTH_TIMEOUT_MS=5000

# Fallos de salud consecutivos antes de reiniciar por "colgado".
# Admite: entero ≥ 1 (por defecto 3).
SUPERVISOR_FAILURES_BEFORE_KILL=3

# Backoff inicial y máximo entre reinicios (exponencial: 1s → 2s → 4s… ).
# Admite: enteros ≥ 1 ms (por defecto 1000 y 30000).
SUPERVISOR_BACKOFF_MS=1000
SUPERVISOR_BACKOFF_MAX_MS=30000

# Cortacircuito: fallos de ARRANQUE consecutivos (el servidor nunca llegó
# a servir) antes de PARAR y avisar (código 70).
# Admite: entero ≥ 0 (por defecto 10; 0 = sin tope, no recomendado:
#         bucle infinito).
SUPERVISOR_MAX_RESTARTS=10

# Caídas en caliente seguidas (el servidor ya servía y se cae) a partir de
# las cuales se avisa del crash-loop. El servicio NO se apaga: sigue
# reiniciando con el backoff máximo.
# Admite: entero ≥ 1 (por defecto 5).
SUPERVISOR_HOT_CRASH_THRESHOLD=5

# Tiempo que el servidor debe seguir sano para dar el incidente por
# cerrado y olvidar la racha de fallos. Efectivo = max(valor, gracia +
# fallos × intervalo) para que sea coherente con el watchdog.
# Admite: entero ≥ 1 ms (por defecto 60000).
SUPERVISOR_STABLE_MS=60000
