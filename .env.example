# Puerto TCP en el que escucha el servidor.
PORT=3000

# Carpeta para las bases de datos y demás datos persistentes.
# Vacío = usar la carpeta "data" dentro del proyecto.
DATA_DIR=data

# Clave maestra Base64 de exactamente 32 bytes para cifrado en reposo.
# Vacío = usar/generar el archivo local .zlapymasterkey. No compartas esta clave.
CHAT_MASTER_KEY=

# Forzar HTTPS: toda petición en claro se redirige a https y la cookie de sesión
# se marca como Secure. Solo tiene efecto si existen cert.pem y key.pem.
# false = no redirigir (tráfico y cookie sin cifrar; úsalo solo en red de confianza).
FORCE_TLS=true

# Interfaz de escucha: auto (todas, por defecto) o loopback (solo esta máquina,
# por ejemplo con un proxy inverso TLS delante).
BIND_HOST=auto

# Rutas de los certificados TLS (avanzado): por defecto cert.pem y key.pem en
# la raíz del proyecto. Apúntalas a otro sitio si tus certificados viven fuera
# del proyecto (por ejemplo tras un proxy que termina el TLS).
TLS_CERT_FILE=
TLS_KEY_FILE=

# Máximo de caracteres por mensaje directo.
MESSAGE_DIRECT_CHAR_LIMIT=10000

# Máximo de caracteres por mensaje de grupo.
MESSAGE_GROUP_CHAR_LIMIT=15000

# Máximo de caracteres en el texto de una historia.
STORY_TEXT_CHAR_LIMIT=140

# Máximo de caracteres en la descripción del perfil.
PROFILE_DESCRIPTION_CHAR_LIMIT=140

# Mensajes máximos permitidos dentro de la ventana indicada abajo.
MESSAGE_RATE_LIMIT=30

# Ventana del límite de mensajes, en milisegundos (60000 = 1 minuto).
MESSAGE_RATE_WINDOW_MS=60000

# Duración máxima de grabación de audio, en milisegundos (60000 = 1 minuto).
MAX_AUDIO_DURATION_MS=60000

# Tamaño máximo del cuerpo de una solicitud HTTP, en bytes (33554432 = 32 MiB).
MAX_HTTP_BODY_BYTES=33554432

# Máximo de caracteres de datos multimedia/cifrados aceptados por mensaje.
MAX_MESSAGE_DATA_CHARS=24000000

# Cantidad máxima de elementos permitidos en una galería.
MAX_GALLERY_ITEMS=20

# Máximo de caracteres codificados permitidos para una galería.
MAX_GALLERY_ENCODED_CHARS=24000000

# Tiempo de vigencia de una nota de perfil, en milisegundos (86400000 = 24 horas).
NOTE_TTL_MS=86400000

# Tiempo que se conserva una página de chat en caché, en milisegundos.
# 0 hace que las entradas de caché nunca se reutilicen.
CHAT_PAGE_CACHE_TTL_MS=10000

# Número máximo de páginas de chat que se conservan en caché.
# 0 desactiva la caché.
CHAT_PAGE_CACHE_MAX=20

# Caché de SQLite, en KiB (64000 ≈ 62.5 MiB por conexión).
SQLITE_CACHE_SIZE_KB=64000

# Tiempo máximo que SQLite espera por una base ocupada, en milisegundos.
SQLITE_BUSY_TIMEOUT_MS=5000

# Tiempo de vigencia de las historias, en milisegundos (86400000 = 24 horas).
STORY_TTL_MS=86400000

# Tiempo de vigencia de una sesión de autenticación, en milisegundos
# (2592000000 = 30 días).
AUTH_SESSION_TTL_MS=2592000000

# Token del túnel de Cloudflare que usa `npm run tunnel` (cloudflared).
# Se obtiene en el panel de Cloudflare (Zero Trust → Networks → Tunnels).
# La configuración del túnel está en zty.yml (copia de zty.yml.example).
CLOUDFLARE_TUNNEL_TOKEN=
# Stickers de Giphy (la usa solo el servidor)
GIPHY_API_KEY=

# ---- Supervisor (npm start) ----
# El supervisor carga este mismo fichero .env: PORT y todas las variables
# SUPERVISOR_* de aquí tienen efecto real sobre `npm start`.
# Fichero donde el supervisor publica el PID del servidor hijo.
SUPERVISOR_PID_FILE=.zlapy.pid
# Ruta que consulta el supervisor para saber si el servidor está sano.
SUPERVISOR_HEALTH_PATH=/healthz
# Puerto inicial del health check; el supervisor lo sustituye por el que
# anuncia el servidor al arrancar (banner "Zlapy (SQLite) en el puerto NNNN").
SUPERVISOR_HEALTH_PORT=
# Cada cuánto comprueba la salud del servidor, en ms.
SUPERVISOR_HEALTH_MS=15000
# Espera máxima (gracia) para que el servidor responda al arrancar, en ms.
SUPERVISOR_STARTUP_MS=30000
# Tiempo de espera de cada chequeo de salud, en ms.
SUPERVISOR_HEALTH_TIMEOUT_MS=5000
# Fallos de salud consecutivos antes de reiniciar por "colgado".
SUPERVISOR_FAILURES_BEFORE_KILL=3
# Backoff inicial y máximo entre reinicios, en ms (1s → 2s → 4s… → 30s).
SUPERVISOR_BACKOFF_MS=1000
SUPERVISOR_BACKOFF_MAX_MS=30000
# Cortacircuito: fallos de ARRANQUE consecutivos (el servidor nunca llegó a
# servir) antes de PARAR y avisar (código 70). 0 = sin tope (no recomendado).
SUPERVISOR_MAX_RESTARTS=10
# Caídas en caliente seguidas (el servidor ya servía y se cae) a partir de las
# cuales se avisa del crash-loop. El servicio NO se apaga: se sigue reiniciando
# con el backoff máximo.
SUPERVISOR_HOT_CRASH_THRESHOLD=5
# Tiempo que el servidor debe seguir sano para dar el incidente por cerrado y
# olvidar la racha de fallos, en ms.
SUPERVISOR_STABLE_MS=60000
