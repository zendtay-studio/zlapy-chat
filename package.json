{
  "name": "zlapy-chat",
  "version": "1.0.0",
  "description": "Zlapy — mensajería y llamadas de voz/vídeo P2P (WebRTC) en tu red local: servidor Node.js con SQLite, WebSocket propio y notificaciones push",
  "main": "server.js",
  "author": "zendtay-studio <zendtaystudio@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zendtay-studio/zlapy-chat.git"
  },
  "bugs": {
    "url": "https://github.com/zendtay-studio/zlapy-chat/issues"
  },
  "homepage": "https://github.com/zendtay-studio/zlapy-chat#readme",
  "keywords": [
    "zlapy",
    "chat",
    "webrtc",
    "websocket",
    "p2p",
    "local",
    "mensajeria",
    "llamadas"
  ],
  "packageManager": "npm@10.9.8",
  "allowScripts": {
    "better-sqlite3": true
  },
  "scripts": {
    "start": "node ops/install/ensure-deps.js && node ops/runtime/supervisor.js",
    "deps": "node ops/install/ensure-deps.js",
    "termux": "pkg update && pkg upgrade -y && pkg install python make clang sqlite && npm i --ignore-scripts && npm run rebuild:sqlite && node ops/install/check-native.js && npm start",
    "tunnel": "node ops/net/tunnel.js",
    "owner": "node ops/auth/owner-credentials.js",
    "test": "node --test --require ./test/bootstrap.js \"test/**/*.test.js\"",
    "generate:emojis": "node ops/data/generate-emoji-data.js",
    "backup": "node ops/backup/backup.js",
    "postinstall": "node ops/install/check-native.js",
    "rebuild:sqlite": "node ops/install/build-sqlite.js",
    "repair:double-encrypted": "node ops/crypto/repair-double-encrypted.js",
    "repair": "node ops/crypto/repair-unreadable-auth-keys.js",
    "sqliteview": "node ops/db/sqliteview.js",
    "dbview": "node ops/db/db-viewer.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "jsonwebtoken": "^9.0.3",
    "lru": "^3.1.0",
    "webp-wasm": "^1.0.6"
  }
}
